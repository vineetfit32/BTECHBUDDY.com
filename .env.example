# BTECHBUDDY Environment Variables Example
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/btechbuddy?schema=public"

JWT_SECRET="replace_with_a_secure_random_string_at_least_32_chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

ADMIN_NAME="Super Administrator"
ADMIN_EMAIL="replace-with-a-unique-admin-email"
ADMIN_PASSWORD="replace-with-a-long-random-password"

# Optional Cloud Storage (defaults to local public/uploads)
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Live lectures. Browser uses LIVEKIT_URL; the app server uses LIVEKIT_INTERNAL_URL inside Docker.
LIVEKIT_URL="ws://127.0.0.1:7880"
LIVEKIT_INTERNAL_URL="http://127.0.0.1:7880"
LIVEKIT_API_KEY="btechbuddy"
LIVEKIT_API_SECRET="change-me-to-a-long-random-livekit-secret"
RECORDINGS_DIR=""

# Optional Payments (Razorpay)
ENABLE_PAYMENTS="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
